# The host venv is Windows-built; the image builds its own at /opt/venv.
.venv/
**/__pycache__/
**/*.pyc

# Caches — large, machine-local, and regenerated on demand.
.mypy_cache/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.cache/
.chroma_db/
.coverage

# The pinned WASI interpreter is fetched by a person and verified by digest
# (D-074). It is mounted from the host at run time, never baked into a layer.
.wasm-runtimes/

# The pinned Semgrep rules are mounted from the host at run time and checked
# against their digests there (D-104); none is baked into a layer.
.semgrep/

# Frontend: not a uv workspace member, not part of a corpus run, and never
# imported by the worker. Excluded whole rather than by subfolder: when it moved
# from apps/dashboard/ the old entries stopped matching, and node_modules, .next
# and the dashboard's .env.local (its OAuth client secret and BETTER_AUTH_SECRET)
# were copied into every image (D-042).
frontend/

# Secrets never enter the build context, at any depth. GEMINI_API_KEY is passed
# at run time and the App's private key is bind-mounted read-only.
**/.env
**/.env.*
# The templates hold names, not values, and a test reads the root one.
!**/.env.example
**/*.pem
**/*.key

# Local tooling and documents, not part of the system.
.git/
.archify/
**/.claude/
**/*.pdf
