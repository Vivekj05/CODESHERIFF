# ==============================================================================
# CodeSheriff Environment Configuration (Template)
# ==============================================================================

# GitHub Authentication (Required for PR fetching and posting comments)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: GitHub Webhook Secret (if configured in repo webhook settings)
GITHUB_WEBHOOK_SECRET=

# Google Gemini API Key (100% Free Tier on Google AI Studio)
# Generate at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Local Vector Database & Cache paths
CHROMA_DB_DIR=./.chroma_db
SEMANTIC_CACHE_PATH=./.cache/llm_cache.db
