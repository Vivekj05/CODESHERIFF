# CodeSheriff — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Per PROJECT_CONTEXT.md §6, the GitHub App private key, webhook secret and LLM
# credentials are supplied via environment variables only.

# ---------------------------------------------------------------------------
# GitHub App  (Chapter 5)
# ---------------------------------------------------------------------------
# Registered at https://github.com/settings/apps. The agreed permissions and events are D-034;
# docs/github-app-setup.md walks through the registration field by field.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The slug in the App's URL (https://github.com/settings/apps/<slug>). Used to build the
# "install on a repository" link the dashboard shows when a session sees no installations.
GITHUB_APP_SLUG=

# Path to the App's .pem private key. Keep it OUTSIDE the repository.
GITHUB_APP_PRIVATE_KEY_PATH=

# Webhook secret. REQUIRED — with it unset the webhook answers 501 and accepts nothing, rather
# than falling back to accepting everything (AUDIT.md 0.1). Must match the App's webhook settings
# exactly. Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# There is deliberately no GITHUB_TOKEN. Chapter 6 removed the last reader: comments are posted
# with an installation token minted from the private key above, which is scoped to the repositories
# the App was actually granted. A personal access token carries whatever its owner can reach.

# ---------------------------------------------------------------------------
# Database  (Chapter 3)
# ---------------------------------------------------------------------------
# PostgreSQL 16 with the pgvector extension. Defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://codesheriff:codesheriff@localhost:5432/codesheriff

# Throwaway database for the `db`-marked tests. UNSET means those tests skip (D-029) — they are
# never faked on SQLite, because pgvector cannot be. Point it at a database you do not mind losing:
# the fixtures downgrade it to base before every session.
#   docker compose up -d postgres
#   CODESHERIFF_TEST_DB=postgresql+psycopg://codesheriff:codesheriff@localhost:5432/codesheriff_test
CODESHERIFF_TEST_DB=

# ---------------------------------------------------------------------------
# Queue  (Chapter 6)
# ---------------------------------------------------------------------------
# The webhook enqueues and returns 202 within 3s; the worker owns the pipeline. The message is an
# audit id and nothing else (D-041) — the row in Postgres is the only copy of the facts.
CELERY_BROKER_URL=redis://localhost:6379/0
AUDIT_QUEUE_NAME=audits

# No result backend. An audit's state is the `audits` row, which the dashboard reads and a human
# can query; a result backend would be a second, weaker copy of it with an expiry attached.

# ---------------------------------------------------------------------------
# LLM  (Chapter 11)
# ---------------------------------------------------------------------------
# Gemini Flash free tier — zero recurring cost is a hard constraint (§6).
# Unset means the semantic agent ABSTAINS. It must never silently return
# "clean" from a stub (AUDIT.md 3.12).
GEMINI_API_KEY=
SEMANTIC_MODEL=gemini-2.0-flash
SEMANTIC_N_SAMPLES=3
SEMANTIC_TEMPERATURE=0.3
SEMANTIC_CACHE_PATH=.cache/semantic_llm_cache.sqlite

# Cost ceiling per ChangeUnit at n=3, in USD (§2 non-functional target).
SEMANTIC_BUDGET_PER_UNIT=0.01

# ---------------------------------------------------------------------------
# Embeddings  (Chapter 12)
# ---------------------------------------------------------------------------
# Local, 384-dim, no API cost. Stored in pgvector — NOT ChromaDB, which §4
# explicitly rejects.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Fusion  (Chapters 9 and 14)
# ---------------------------------------------------------------------------
# Path to the fitted calibration artifact. Until Chapter 14 produces it, fusion
# runs on provisional hand-set ratios and must say so in its output.
# Nothing here may be treated as calibrated (D-010).
CALIBRATION_PATH=packages/engine/calibration.json

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Host and port are uvicorn's arguments, not settings: `uvicorn codesheriff_api.main:app --port X`.
# They were config keys until Chapter 6, read by a `serve` command that booted the unauthenticated
# webhook. Both are gone.
#
# The webhook URL lives on the GitHub App, not here — nothing in this process needs to know its own
# public address. In development it is a smee.io channel forwarded to localhost (D-043):
#   npx smee-client --url https://smee.io/<channel> --path /webhooks/github --port 8000

# ---------------------------------------------------------------------------
# Sign-in  (Chapter 5)
# ---------------------------------------------------------------------------
# Where GitHub sends the user back. The App's Callback URL must be exactly this + /auth/callback,
# or the code exchange fails with an error that says nothing useful.
API_PUBLIC_URL=http://localhost:8000

# The single browser origin allowed to call the API with credentials. Not a list, and never "*":
# a wildcard cannot carry cookies at all, and one that could would let any page on the internet
# make authenticated calls with a user's session.
DASHBOARD_ORIGIN=http://localhost:3000

# Send the session cookie only over HTTPS. False is for http://localhost development ONLY —
# set it true in any deployment. A session cookie on plain HTTP is a session anyone on the path
# can take.
SESSION_COOKIE_SECURE=false

# The dashboard reads NEXT_PUBLIC_API_BASE_URL, which Next.js inlines at BUILD time, not runtime.
# It lives in apps/dashboard/.env.local, defaults to http://localhost:8000, and changing it means
# rebuilding rather than restarting.
